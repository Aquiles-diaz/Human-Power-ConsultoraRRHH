{
  "name": "human-power-rrhh",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "frontend": "vite",
    "backend": ".venv/bin/python -m uvicorn backend.main:app --reload --port 10000",
    "dev": "concurrently -k -n WEB,API -c green,blue \"npm run frontend\" \"npm run backend\"",
    "dev:lan": "LAN_HTTPS=1 concurrently -k -n WEB,API -c green,blue \"vite --host\" \"npm run backend\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:api": ".venv/bin/python -m pytest backend/tests -q",
    "lint": "eslint .",
    "optimize:images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.2.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-oauth/google": "^0.13.5",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.543.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "recharts": "^3.9.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.9.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vercel/node": "^5.9.9",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.3",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.6",
    "sharp": "^0.35.2",
    "supabase": "^2.105.0",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "ajv@8": "^8.20.0",
    "js-yaml@4": "^4.3.1",
    "minimatch@10": "^10.2.6",
    "path-to-regexp@6": "6.3.0",
    "smol-toml@1": "^1.8.0"
  }
}
