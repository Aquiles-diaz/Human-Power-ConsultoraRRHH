# ============================================================================
# HumanPower — Variables de entorno (ejemplo). NO pongas valores reales acá.
# Copialo a backend/.env  (o ./.env) y completá con tus credenciales.
# backend/.env ya está en .gitignore: nunca se sube al repo.
# ============================================================================

# ── Postgres (Supabase) ──────────────────────────────────────────────────────
# App / runtime: usá el POOLER (puerto 6543, modo transaction). Ideal para
# serverless/Vercel y para muchas conexiones cortas. Agregá ?sslmode=require.
DATABASE_URL=postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Migraciones / seed: conexión DIRECTA (puerto 5432). Usala para correr
# scripts/migrate-data.py y el seed del admin.
DIRECT_URL=postgresql://postgres:<DB_PASSWORD>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Con el pooler hay que desactivar prepared statements de psycopg (1 = off).
PG_DISABLE_PREPARE=1

# Aplicar el esquema (migrations/001_schema.sql) al arrancar la app.
#   1 (default) = lo corre al startup, idempotente. Útil en dev.
#   0           = lo saltea. Recomendado en PROD: el esquema ya está aplicado
#                 por las migraciones y así evitás correr DDL en cada arranque.
RUN_INIT_DB=1

# ── Supabase API / Storage ───────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
# anon key: pública, sólo si el frontend la necesitara (no expongas la service role).
SUPABASE_ANON_KEY=<supabase-anon-key>
# service role key: SOLO backend. Da acceso total al Storage/DB; nunca al frontend.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# Buckets (privados)
CV_BUCKET=cvs
PHOTO_BUCKET=profile-photos
# Vencimiento (segundos) de las URLs firmadas para descargar CVs privados.
SIGNED_URL_TTL=3600
# Entrega de archivos privados: "stream" (default, el backend devuelve los bytes)
# o "redirect" (307 a una URL firmada; más liviano para serverless/Vercel).
CV_DELIVERY=stream

# ── Seguridad de la app ──────────────────────────────────────────────────────
# Secreto para firmar los JWT. OBLIGATORIO (mín. 32 chars): el backend no
# arranca sin él. Generá uno fuerte con: openssl rand -hex 32
SECRET_KEY=<jwt-secret-largo-y-aleatorio>

# Origenes permitidos para CORS (separados por coma). En prod: el dominio real.
CORS_ORIGINS=http://localhost:5173

# Límites de subida (bytes). Opcionales: tienen defaults en el código.
MAX_UPLOAD_BYTES=15728640
MAX_IMAGE_BYTES=5242880

# Rate limit anti-abuso de los endpoints de subida (por IP del cliente). Opcionales:
# tienen defaults razonables en el código. Formato slowapi "N/period". Evitan que
# alguien martille /cv, /apply o /me/profile/* y llene el bucket de Supabase.
# Requiere correr uvicorn con --proxy-headers detrás de Render/Vercel (ver render.yaml).
CV_UPLOAD_RATE_LIMIT_MIN=5/minute
CV_UPLOAD_RATE_LIMIT_HOUR=20/hour
APPLY_RATE_LIMIT_MIN=10/minute
APPLY_RATE_LIMIT_HOUR=40/hour
PROFILE_UPLOAD_RATE_LIMIT_MIN=10/minute
PROFILE_UPLOAD_RATE_LIMIT_HOUR=40/hour

# ── Seed del admin (lo usa `python -m backend.seed_admin`) ──────────────────
# ADMIN_PASSWORD_SEED es OBLIGATORIO: el seed aborta si no lo definís (no usa
# ninguna contraseña por defecto). Mínimo 8 caracteres.
ADMIN_EMAIL=admin@humanpower.com
ADMIN_PASSWORD_SEED=<contraseña-admin-inicial>
ADMIN_NAME=Sergio Ducca

# ── Email transaccional (reset de contraseña / verificación de email) ───────
# URL del frontend para armar los links de los correos.
FRONTEND_URL=http://localhost:5173
# Destinatario de las consultas del formulario de contacto público (POST /contacto).
CONTACT_TO=humanpower.rrhh@gmail.com
# Precedencia del envío: BREVO_API_KEY (HTTP) > SMTP_HOST (SMTP) > dev (loguea).
#
# EN PROD (Render): se usa BREVO (API HTTP, puerto 443). Render free BLOQUEA el
# SMTP saliente (25/465/587) → por SMTP da timeout. Brevo gratis: 300 mails/día.
#   1) Crear cuenta en brevo.com con humanpower.rrhh@gmail.com.
#   2) Verificar el remitente (Senders) humanpower.rrhh@gmail.com.
#   3) API key (SMTP & API → API Keys, empieza con xkeysib-) → BREVO_API_KEY.
#   4) Desactivar "IPs autorizadas → Claves API" (la IP de Render es dinámica).
#   El remitente se toma de SMTP_FROM. Ver docs/SETUP-email-google.md.
BREVO_API_KEY=
#
# Sin SMTP_HOST ni BREVO_API_KEY (dev) los links se LOGUEAN en consola.
#
# ALTERNATIVA (local/otros hosts sin bloqueo): Gmail SMTP (~500 mails/día). Pasos:
#   1) En la cuenta humanpower.rrhh@gmail.com: activar Verificación en 2 pasos.
#   2) Crear una "Contraseña de aplicación" (App Password) → código de 16 letras.
#   3) Completar:
#        SMTP_HOST=smtp.gmail.com   SMTP_PORT=587   SMTP_STARTTLS=true
#        SMTP_USER=humanpower.rrhh@gmail.com
#        SMTP_PASSWORD=<las 16 letras del App Password, sin espacios>
#        SMTP_FROM=Human Power RRHH <humanpower.rrhh@gmail.com>
#   Gmail reescribe el "From" al de la cuenta autenticada: por eso SMTP_FROM
#   debe ser ese mismo gmail (o un alias verificado en "Enviar como").
#
# ESCALADO (si algún día se superan los ~500/día): Resend (3000/mes gratis) con
# dominio propio verificado. Solo cambian estas vars, no el código:
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=587  SMTP_USER=resend
#   SMTP_PASSWORD=<API key de Resend>  SMTP_FROM=no-reply@tudominio.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Human Power RRHH <humanpower.rrhh@gmail.com>
SMTP_STARTTLS=true

# ── Recordatorios de perfil incompleto (POST /tasks/profile-reminders) ───────
# Mail a quien se registró y sigue sin CV ni video, con link directo al perfil
# y el ebook al 100% como incentivo. El reloj es el cron de GitHub Actions
# (.github/workflows/recordatorios.yml), que llama al endpoint cada hora.
#
# Secreto compartido con ese cron: el MISMO valor va en Render (env var) y en
# GitHub (Settings → Secrets → Actions → CRON_SECRET). Vacío = tarea apagada
# (el endpoint responde 403 siempre). Generar uno: openssl rand -hex 32
CRON_SECRET=
# Escalones de envío, en horas desde el registro (a lo sumo un mail por corrida
# por usuario; cada escalón se manda una sola vez, queda en profile_nudges).
REMINDER_HOURS=24,72,168
# Techo de mails por corrida (Brevo free corta en 300/día).
REMINDER_BATCH_MAX=100

# ── Login con Google (opcional) ──────────────────────────────────────────────
# OAuth Client ID (tipo "Aplicación web") de Google Cloud Console. Mismo valor
# en el backend (GOOGLE_CLIENT_ID) y en el build del frontend (VITE_GOOGLE_CLIENT_ID).
# Si quedan vacíos, el login con Google simplemente no aparece / responde 503.
GOOGLE_CLIENT_ID=
# VITE_GOOGLE_CLIENT_ID=<el mismo Client ID>   (var de build del frontend)

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Base de la API que usa el frontend. En dev se puede dejar vacío y cae al proxy
# "/api" de Vite (vite.config.ts). En PROD es OBLIGATORIO setearlo en build: el
# build estático no tiene proxy, así que sin esto las llamadas pegan contra el
# host estático y dan 404. Es una var de build (VITE_), no de runtime.
# VITE_API_URL=https://tu-backend.example.com
